rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.role == "admin";
    }

    function isPartner() {
      return request.auth != null && request.auth.token.role == "partner";
    }

    function isAuthenticated() {
      return request.auth != null && (isAdmin() || isPartner());
    }

    function isValidImage() {
      return request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isValidFile() {
      return request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Memories: photos/memories/{memoryId}/originals|thumbs/{fileName}
    // Both admin and partner can upload originals; thumbs are written by CF.
    // ─────────────────────────────────────────────────────────────────────────
    match /memories/{memoryId}/{folder}/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isValidFile()
                    && (folder == 'originals' || folder == 'thumbs');
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Snapshots (instantáneas): snapshots/{snapshotId}/originals/{fileName}
    //   — Both admin AND partner can upload (either can send a snapshot).
    //   — Reading allowed for both (to display the photo when received).
    //   — Thumbnails folder reserved for Cloud Functions.
    // ─────────────────────────────────────────────────────────────────────────
    match /snapshots/{snapshotId}/{folder}/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isValidImage()
                    && (folder == 'originals' || folder == 'thumbs');
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Capsules: only admin uploads capsule contents
    // ─────────────────────────────────────────────────────────────────────────
    match /capsules/{capsuleId}/{allPaths=**} {
      allow read:   if isAuthenticated();
      allow write:  if isAdmin() && isValidFile();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Artifacts (tickets, scanned PDFs, etc.)
    // ─────────────────────────────────────────────────────────────────────────
    match /artifacts/{artifactId}/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && isValidFile();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Wrapped assets — generated by Cloud Function
    // ─────────────────────────────────────────────────────────────────────────
    match /wrapped/{year}/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Backups — admin only
    // ─────────────────────────────────────────────────────────────────────────
    match /backups/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
