rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isPartner() {
      return isAuthenticated() && request.auth.token.role == 'partner';
    }

    function matchesRelationship(rid) {
      return isAuthenticated() && request.auth.token.relationshipId == rid;
    }

    // Path-based security: /{relationshipId}/{module}/{docId}/{fileName}
    match /{relationshipId}/{module}/{docId}/{fileName} {
      allow read, write: if matchesRelationship(relationshipId);
    }

    // Snapshots: {relationshipId}/snapshots/{fileName} (3 Levels)
    match /{relationshipId}/snapshots/{fileName} {
      allow read, write: if matchesRelationship(relationshipId);
    }

    // Support for legacy or flat paths during migration/dev
    match /memories/{memoryId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); 
    }

    match /snapshots/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /{relationshipId}/backups/{allPaths=**} {
      allow read, write: if isAdmin() && matchesRelationship(relationshipId);
    }
  }
}
