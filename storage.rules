rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isPartner() {
      return isAuthenticated() && request.auth.token.role == 'partner';
    }

    function matchesRelationship(rid) {
      return isAuthenticated() && request.auth.token.relationshipId == rid;
    }

    // Path-based security: /{relationshipId}/{module}/{docId}/{fileName}
    match /{relationshipId}/{module}/{docId}/{fileName} {
      allow read, write: if matchesRelationship(relationshipId);
    }
    
    // Modules: memories, capsules, snapshots, artifacts, backups
    // Note: The general match above covers all modules if they follow the pattern.
    // If specific modules need different logic (e.g. admin only), they can be added here.
    
    match /{relationshipId}/backups/{allPaths=**} {
      allow read, write: if isAdmin() && matchesRelationship(relationshipId);
    }
  }
}
