+/* ─────────────────────────────────────────────────────────────────────────
+   PastelToast v2.4 — Top-Aligned Attention Edition
+   ───────────────────────────────────────────────────────────────────────── */
+
+.viewport {
+    position: fixed;
+    top: calc(24px + env(safe-area-inset-top, 0px));
+    left: 50%;
+    transform: translateX(-50%);
+    z-index: 10000;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 14px;
+    pointer-events: none;
+    max-width: calc(100vw - 40px);
+}
+
+.toast {
+    pointer-events: auto;
+    cursor: pointer;
+    display: flex;
+    align-items: center;
+    gap: 16px;
+    padding: 14px 22px;
+    min-width: 300px;
+    max-width: 440px;
+
+    backdrop-filter: blur(16px) saturate(140%);
+    -webkit-backdrop-filter: blur(16px) saturate(140%);
+    border-radius: var(--radius-lg);
+    border: 3px solid white;
+    
+    font-family: var(--font-body);
+    user-select: none;
+    overflow: hidden;
+    position: relative;
+    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
+}
+
+.toast:active {
+    transform: scale(0.96);
+}
+
+/* ─── Type Variants (Pastel & Attention Grabbing) ─── */
+.success {
+    background: rgba(220, 252, 231, 0.95); /* Pastel Mint */
+    border-color: rgba(136, 216, 176, 0.6);
+    box-shadow: 
+        0 20px 40px -12px rgba(136, 216, 176, 0.4),
+        0 4px 0 rgba(116, 198, 157, 0.2);
+}
+
+.error {
+    background: rgba(255, 241, 242, 0.95); /* Pastel Rose */
+    border-color: rgba(255, 117, 143, 0.6);
+    box-shadow: 
+        0 20px 40px -12px rgba(255, 117, 143, 0.4),
+        0 4px 0 rgba(255, 117, 143, 0.2);
+}
+
+.info, .loading {
+    background: rgba(236, 254, 255, 0.95); /* Pastel Sky */
+    border-color: rgba(129, 230, 217, 0.6);
+    box-shadow: 
+        0 20px 40px -12px rgba(136, 216, 176, 0.3),
+        0 4px 0 rgba(79, 209, 197, 0.2);
+}
+
+/* ─── Badge (Icon Container) ─── */
+.badge {
+    width: 40px;
+    height: 40px;
+    flex-shrink: 0;
+    border-radius: 14px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    padding: 9px;
+    box-sizing: border-box;
+}
+
+.badge_success {
+    background: var(--gradient-mint);
+    color: white;
+}
+
+.badge_error {
+    background: var(--gradient-rose);
+    color: white;
+}
+
+.badge_info, .badge_loading {
+    background: linear-gradient(135deg, #4fd1c5 0%, #38b2ac 100%);
+    color: white;
+}
+
+/* ─── Text Styling ─── */
+.content {
+    display: flex;
+    flex-direction: column;
+    gap: 2px;
+    flex: 1;
+    min-width: 0;
+}
+
+.title {
+    font-family: var(--font-display);
+    font-weight: 800;
+    font-size: 1.05rem;
+    line-height: 1.2;
+    color: var(--text-primary);
+    letter-spacing: -0.01em;
+}
+
+.description {
+    font-size: 0.85rem;
+    line-height: 1.4;
+    color: var(--text-muted);
+    font-weight: 600;
+}
+
+/* ─── Animations ─── */
+.loading::after {
+    content: "";
+    position: absolute;
+    top: 0;
+    left: -100%;
+    width: 200%;
+    height: 100%;
+    background: linear-gradient(
+        90deg,
+        transparent,
+        rgba(255, 255, 255, 0.4),
+        transparent
+    );
+    animation: shimmer 1.8s infinite;
+}
+
+@keyframes shimmer {
+    to { transform: translateX(50%); }
+}
+
+.spin {
+    animation: spin 0.8s linear infinite;
+}
+
+@keyframes spin {
+    to { transform: rotate(360deg); }
+}
