rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.role == "admin";
    }

    function isPartner() {
      return isAuthenticated() &&
             request.auth.token.role == "partner";
    }

    function isNotRevoked() {
      // Allow if doc doesn't exist (yet) or if isRevoked is false
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() &&
             (!exists(userDoc) || !get(userDoc).data.get('isRevoked', false));
    }

    function isValidDevice() {
      // For partners, verify the deviceId in the token matches the document
      // If no deviceId in token (testing/seeds), we allow if document exists
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isPartner() &&
             exists(userDoc) &&
             (!('deviceId' in request.auth.token) || request.auth.token.deviceId == get(userDoc).data.deviceId);
    }

    function canAccess() {
      return isAdmin() || (isPartner() && isNotRevoked() && isValidDevice());
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    // ── USERS ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // DIAGNOSTIC: Permisivo temporal para depurar el objeto auth
      allow read: if true;
      
      // Admin global access
      allow read, write: if isAdmin();

      // Self-update for specific fields
      allow update: if isAuthenticated() && request.auth.uid == userId && (
        // For partners, we restrict the keys
        (request.auth.token.role == "partner" && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["preferences", "fcmTokens", "lastActiveAt", "deviceInfo", "welcomeSeen", "teaserCompleted", "onboardingCompleted"])) 
        || 
        // For admin, we allow everything (already covered by line 46, but being explicit)
        (request.auth.token.role == "admin")
      );
    }

    // ── INVITE TOKENS ────────────────────────────────────────────────────────
    match /inviteTokens/{tokenId} {
      allow read: if isAdmin() || request.auth == null;
      allow write: if isAdmin();
    }

    // ── PLACES ───────────────────────────────────────────────────────────────
    match /places/{placeId} {
      allow read: if canAccess();
      allow create, update: if canAccess();
      allow delete: if isAdmin();
    }

    // ── MEMORIES ─────────────────────────────────────────────────────────────
    match /memories/{memoryId} {
      allow read: if canAccess();
      allow create: if canAccess() &&
        request.resource.data.uploadedBy == request.auth.uid;
      allow update: if isAdmin() ||
        (isPartner() && isNotRevoked() && isValidDevice() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["isSpecial", "updatedAt"]));
      allow delete: if isAdmin();

      // ── PHOTOS SUBCOLLECTION ──────────────────────────────────────────────
      match /photos/{photoId} {
        allow read: if canAccess();
        allow create: if canAccess() &&
          request.resource.data.uploadedBy == request.auth.uid;
        allow update: if isAdmin() ||
          (isPartner() && isNotRevoked() && isValidDevice() &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["isSpecial", "partnerNote", "uploadStatus"]));
        allow delete: if isAdmin();
      }

      match /artifacts/{artifactId} {
        allow read: if canAccess();
        allow create: if canAccess() &&
          request.resource.data.uploadedBy == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── ARTIFACTS ────────────────────────────────────────────────────────────
    match /artifacts/{artifactId} {
      allow read: if canAccess();
      allow create: if canAccess() &&
        request.resource.data.uploadedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── CAPSULES ─────────────────────────────────────────────────────────────
    match /capsules/{capsuleId} {
      allow read: if isAdmin() ||
        (isPartner() && isNotRevoked() && isValidDevice() &&
         resource.data.isUnlocked == true &&
         resource.data.isDestructed == false);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isPartner() && isNotRevoked() && isValidDevice() &&
         resource.data.isUnlocked == true &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["openedByPartner", "openedAt"]));
    }

    // ── COUPONS ──────────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      allow read: if canAccess() &&
        (isAdmin() || resource.data.isActive == true);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isPartner() && isNotRevoked() && isValidDevice() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["isUsed", "usedAt", "usedNotes"]));
    }

    // ── BINGO BOARD ──────────────────────────────────────────────────────────
    match /bingoBoard/{docId} {
      allow read: if canAccess();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isPartner() && isNotRevoked() && isValidDevice() &&
         request.resource.data.categories.size() == resource.data.categories.size() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categories', 'completedCount', 'updatedAt']));
    }

    // ── INSTANTANEAS ──────────────────────────────────────────────────────────
    match /instantaneas/{id} {
      allow read: if isAdmin() || (isPartner() && isNotRevoked());
      allow create: if isAdmin() || (isPartner() && isNotRevoked());
      allow update: if isAdmin() || (isPartner() && isNotRevoked() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSeen', 'seenAt']));
      allow delete: if isAdmin();

      match /photos/{photoId} {
        allow read: if canAccess();
        allow create: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── WRAPPED DATA ─────────────────────────────────────────────────────────
    match /wrappedData/{year} {
      allow read: if canAccess() &&
        (isAdmin() ||
         get(/databases/$(database)/documents/appConfig/main).data.visibility.showWrapped == true);
      allow create, update, delete: if isAdmin();
    }

    // ── ACTIVITY LOG ─────────────────────────────────────────────────────────
    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isPartner() && isNotRevoked() && isValidDevice() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["isReadByAdmin"]);
      allow delete: if isAdmin();
    }

    // ── APP CONFIG ───────────────────────────────────────────────────────────
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
