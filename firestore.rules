rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ──────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isPartner() {
      return isAuthenticated() && request.auth.token.role == 'partner';
    }

    function matchesRelationship(rid) {
      return isAuthenticated() && request.auth.token.relationshipId == rid;
    }

    // ── GLOBAL COLLECTIONS ───────────────────────────────────────────────

    match /users/{userId} {
      // Read access: self OR shared relationship
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        matchesRelationship(resource.data.relationshipId)
      );

      // Write access (Update): self only (limited for partner, full for admin)
      allow update: if isAuthenticated() && request.auth.uid == userId && (
        (request.auth.token.role == "partner" &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["preferences", "fcmTokens", "lastActiveAt", "deviceInfo", "welcomeSeen", "teaserCompleted", "onboardingCompleted", "gameCoins", "coinTransactions"]))
        ||
        (request.auth.token.role == "admin")
      );

      // Special Case: Admin can update accountStatus of their partner (same relationship)
      allow update: if isAdmin() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["accountStatus"]) &&
        matchesRelationship(resource.data.relationshipId);
    }

    match /inviteTokens/{token} {
      allow read: if false;  // UI should use Cloud Functions (validateInviteToken)
      allow create: if isAdmin();
      allow write: if false; // Solo backend via Cloud Functions
    }

    match /places/{placeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      // visitedBy se actualiza vía backend con validación de relationshipId
    }

    // ── SUBCOLLECTIONS BY RELATIONSHIP ────────────────────────────────────

    match /relationships/{relationshipId}/{document=**} {
      allow read, write: if matchesRelationship(relationshipId);
    }
  }
}
